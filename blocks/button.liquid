<div class="floating-button-box">
  {% render 'button', link: block.settings.link %}
</div>

<style>
  .floating-button-box {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 9999;

    background: #ffffff;
    padding: 16px;
    border-radius: 18px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.16);

    display: flex;
    align-items: center;
    justify-content: center;

    transition: all 0.25s ease;
  }

  .floating-button-box:hover {
    background: #f2f2f2;
    transform: translateY(-3px);
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.22);
  }

  .floating-button-box .button,
  .floating-button-box .button-secondary,
  .floating-button-box .link {
    margin: 0;
    transition: all 0.25s ease;
  }

  .floating-button-box:hover .button,
  .floating-button-box:hover .button-secondary {
    background-color: #d9d9d9;
    border-color: #d9d9d9;
    color: #111111;
  }

  @media screen and (max-width: 749px) {
    .floating-button-box {
      right: 16px;
      bottom: 16px;
      padding: 12px;
      border-radius: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "t:names.button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.button_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "link",
          "label": "t:options.link"
        }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.button",
      "category": "t:categories.basic",
      "settings": {
        "link": "shopify://collections/all"
      }
    }
  ]
}
{% endschema %}