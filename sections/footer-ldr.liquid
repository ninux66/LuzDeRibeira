<div class="footer-ldr">
  <div class="footer-ldr__top page-width">

    <div class="footer-ldr__brand">
      <a href="{{ routes.root_url }}" class="footer-ldr__logo-link">
        {%- if settings.logo != blank -%}
          {{
            settings.logo
            | image_url: height: 52
            | image_tag:
              class: 'footer-ldr__logo-img',
              alt: shop.name,
              loading: 'lazy'
          }}
        {%- else -%}
          <span class="footer-ldr__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      <p class="footer-ldr__tagline">
        Artesanía marina hecha a mano<br>
        desde Ribeira, Galicia.
      </p>
    </div>

    <nav class="footer-ldr__nav" aria-label="Navegación footer">
      <div class="footer-ldr__nav-col">
        <h3 class="footer-ldr__nav-heading">La Tienda</h3>
        <ul class="footer-ldr__nav-list">
          {%- if linklists['main-menu'].links.size > 0 -%}
            {%- for link in linklists['main-menu'].links -%}
              <li><a href="{{ link.url }}" class="footer-ldr__nav-link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.collections_url }}" class="footer-ldr__nav-link">Colección</a></li>
            <li><a href="{{ routes.root_url }}collections/cuadros" class="footer-ldr__nav-link">Cuadros</a></li>
            <li><a href="{{ routes.root_url }}collections/collares" class="footer-ldr__nav-link">Collares</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div class="footer-ldr__nav-col">
        <h3 class="footer-ldr__nav-heading">Nosotros</h3>
        <ul class="footer-ldr__nav-list">
          {%- if linklists['nosotros-menu'].links.size > 0 -%}
            {%- for link in linklists['nosotros-menu'].links -%}
              <li><a href="{{ link.url }}" class="footer-ldr__nav-link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.root_url }}pages/nuestra-historia" class="footer-ldr__nav-link">Nuestra Historia</a></li>
            <li><a href="{{ routes.root_url }}pages/contacto" class="footer-ldr__nav-link">Contacto</a></li>
          {%- endif -%}
        </ul>
      </div>
    </nav>

    <div class="footer-ldr__newsletter">
      <h3 class="footer-ldr__nl-heading">Recibe las novedades</h3>
      <p class="footer-ldr__nl-desc">
        Nuevas piezas, historias de la costa y acceso anticipado a ediciones limitadas.
      </p>
      {%- form 'customer', id: 'footer-ldr-newsletter', class: 'footer-ldr__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="footer-ldr__form-row">
          <input
            type="email"
            name="contact[email]"
            placeholder="tu@email.com"
            class="footer-ldr__input"
            required
            autocomplete="email"
          >
          <button type="submit" class="footer-ldr__submit" aria-label="Suscribirme">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="footer-ldr__success">¡Gracias por suscribirte!</p>
        {%- endif -%}
      {%- endform -%}
    </div>

  </div>

  <div class="footer-ldr__bottom page-width">
    <p class="footer-ldr__copyright">© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    <ul class="footer-ldr__policies" aria-label="Políticas">
      {%- if shop.privacy_policy != blank -%}
        <li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>
      {%- endif -%}
      {%- if shop.refund_policy != blank -%}
        <li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>
      {%- endif -%}
      {%- if shop.shipping_policy != blank -%}
        <li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>
      {%- endif -%}
    </ul>
    <div class="footer-ldr__social">
      <a href="https://www.instagram.com/" class="footer-ldr__social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
        </svg>
      </a>
      <a href="https://www.pinterest.com/" class="footer-ldr__social-link" aria-label="Pinterest" target="_blank" rel="noopener noreferrer">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.39 9.29-.09-.78-.17-1.98.03-2.83.19-.77 1.28-5.43 1.28-5.43s-.33-.65-.33-1.62c0-1.52.88-2.66 1.97-2.66.93 0 1.38.7 1.38 1.54 0 .94-.6 2.34-.91 3.64-.26 1.09.54 1.97 1.61 1.97 1.93 0 3.42-2.04 3.42-4.97 0-2.6-1.87-4.42-4.54-4.42-3.09 0-4.91 2.32-4.91 4.72 0 .93.36 1.94.8 2.48.09.11.1.2.07.31-.08.33-.26 1.09-.3 1.24-.05.2-.17.24-.38.15-1.44-.67-2.34-2.78-2.34-4.48 0-3.64 2.64-6.98 7.62-6.98 4 0 7.11 2.85 7.11 6.66 0 3.97-2.5 7.17-5.97 7.17-1.17 0-2.27-.61-2.64-1.32l-.72 2.69c-.26 1-.96 2.26-1.43 3.02.94.29 1.93.45 2.95.45 5.52 0 10-4.48 10-10S17.52 2 12 2z"/>
        </svg>
      </a>
    </div>
  </div>
</div>

{% stylesheet %}
  .footer-ldr {
    background: #1a2744;
    padding-top: 80px;
  }

  .footer-ldr__top {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    gap: 56px;
    padding-bottom: 64px;
    padding-left: clamp(24px, 5vw, 80px);
    padding-right: clamp(24px, 5vw, 80px);
  }

  /* Brand */
  .footer-ldr__brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .footer-ldr__logo-link {
    display: inline-block;
    text-decoration: none;
  }

  .footer-ldr__logo-img {
    display: block;
    max-height: 52px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .footer-ldr__logo-text {
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: 400;
    color: #f5f0e8;
    letter-spacing: 0.05em;
  }

  .footer-ldr__tagline {
    font-family: var(--font-body--family);
    font-size: 0.82rem;
    line-height: 1.75;
    color: rgba(245, 240, 232, 0.5);
    margin: 0;
  }

  /* Navigation */
  .footer-ldr__nav {
    display: flex;
    gap: 48px;
  }

  .footer-ldr__nav-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .footer-ldr__nav-heading {
    font-family: var(--font-body--family);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    color: #c9a84c;
    text-transform: uppercase;
    margin: 0;
  }

  .footer-ldr__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .footer-ldr__nav-link {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    color: rgba(245, 240, 232, 0.65);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-ldr__nav-link:hover {
    color: #f5f0e8;
  }

  /* Newsletter */
  .footer-ldr__newsletter {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-ldr__nl-heading {
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    font-weight: 400;
    color: #f5f0e8;
    margin: 0;
    line-height: 1.3;
  }

  .footer-ldr__nl-desc {
    font-family: var(--font-body--family);
    font-size: 0.8rem;
    line-height: 1.65;
    color: rgba(245, 240, 232, 0.55);
    margin: 0;
  }

  .footer-ldr__form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .footer-ldr__form-row {
    display: flex;
    align-items: center;
    border-bottom: 1.5px solid rgba(245, 240, 232, 0.4);
    margin-top: 4px;
  }

  .footer-ldr__input {
    flex: 1;
    background: transparent !important;
    background-color: transparent !important;
    border: none;
    outline: none;
    color: #f5f0e8 !important;
    font-family: var(--font-body--family);
    font-size: 0.85rem;
    padding: 10px 0;
    box-shadow: none !important;
    -webkit-box-shadow: none !important;
  }

  .footer-ldr__input::placeholder {
    color: rgba(245, 240, 232, 0.4) !important;
  }

  .footer-ldr__submit {
    background: transparent;
    border: none;
    cursor: pointer;
    color: #c9a84c;
    padding: 10px 0 10px 14px;
    display: flex;
    align-items: center;
    transition: color 0.2s ease;
    flex-shrink: 0;
  }

  .footer-ldr__submit:hover {
    color: #f5f0e8;
  }

  .footer-ldr__success {
    font-family: var(--font-body--family);
    font-size: 0.8rem;
    color: #c9a84c;
    margin: 0;
  }

  /* Bottom bar */
  .footer-ldr__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px clamp(24px, 5vw, 80px);
    border-top: 1px solid rgba(245, 240, 232, 0.1);
  }

  .footer-ldr__copyright {
    font-family: var(--font-body--family);
    font-size: 0.72rem;
    color: rgba(245, 240, 232, 0.35);
    margin: 0;
  }

  .footer-ldr__policies {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .footer-ldr__policies a {
    font-family: var(--font-body--family);
    font-size: 0.72rem;
    color: rgba(245, 240, 232, 0.35);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-ldr__policies a:hover {
    color: rgba(245, 240, 232, 0.65);
  }

  .footer-ldr__social {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .footer-ldr__social-link {
    color: rgba(245, 240, 232, 0.45);
    display: flex;
    align-items: center;
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .footer-ldr__social-link:hover {
    color: #c9a84c;
  }

  @media screen and (max-width: 999px) {
    .footer-ldr__top {
      grid-template-columns: 1fr 1fr;
      gap: 48px 40px;
    }

    .footer-ldr__brand {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 749px) {
    .footer-ldr {
      padding-top: 56px;
    }

    .footer-ldr__top {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-bottom: 48px;
    }

    .footer-ldr__brand {
      grid-column: auto;
    }

    .footer-ldr__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .footer-ldr__policies {
      gap: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer — Luz de Ribeira",
  "tag": "div",
  "class": "footer-ldr-wrapper",
  "settings": [],
  "presets": [{ "name": "Footer — Luz de Ribeira" }]
}
{% endschema %}
