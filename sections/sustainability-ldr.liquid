<section
  class="sust-ldr"
  style="position:relative;width:100%;overflow:hidden;display:block;"
>
  {%- if section.settings.image != blank -%}
    <div style="position:absolute;inset:0;z-index:0;">
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          widths: '800,1200,1600,1920,2560',
          sizes: '100vw',
          loading: 'lazy',
          alt: 'Conchas de las costas gallegas — Luz de Ribeira',
          style: 'width:100%;height:100%;object-fit:cover;object-position:center;display:block;'
      }}
    </div>
  {%- endif -%}

  <div style="position:absolute;inset:0;background:rgba(26,39,68,0.78);z-index:1;pointer-events:none;"></div>

  <div class="page-width" style="position:relative;z-index:2;padding:108px 2rem;display:flex;flex-direction:column;align-items:center;text-align:center;">
    <span class="sust-ldr__eyebrow">— Compromiso sostenible —</span>

    <h2 class="sust-ldr__quote">
      Recogidas con amor.<br>
      <em>Recicladas con propósito.</em>
    </h2>

    <div class="sust-ldr__stats">
      <div class="sust-ldr__stat">
        <strong class="sust-ldr__num">100%</strong>
        <span class="sust-ldr__lbl">Conchas recicladas</span>
      </div>
      <div class="sust-ldr__divider" aria-hidden="true"></div>
      <div class="sust-ldr__stat">
        <strong class="sust-ldr__num">0</strong>
        <span class="sust-ldr__lbl">Plásticos en el embalaje</span>
      </div>
      <div class="sust-ldr__divider" aria-hidden="true"></div>
      <div class="sust-ldr__stat">
        <strong class="sust-ldr__num">1</strong>
        <span class="sust-ldr__lbl">Taller artesanal en Ribeira</span>
      </div>
    </div>

    <a href="{{ routes.root_url }}pages/nuestra-historia" class="sust-ldr__btn">
      Nuestra Historia
    </a>
  </div>
</section>

{% stylesheet %}
  .sust-ldr__eyebrow {
    display: block;
    font-family: var(--font-body--family);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: #c9a84c;
    text-transform: uppercase;
    margin-bottom: 1.75rem;
  }

  .sust-ldr__quote {
    font-family: var(--font-heading--family);
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 300;
    line-height: 1.15;
    color: #f5f0e8;
    margin: 0 0 3.5rem;
  }

  .sust-ldr__quote em {
    font-style: italic;
  }

  .sust-ldr__stats {
    display: flex;
    align-items: center;
    margin-bottom: 3.5rem;
    width: 100%;
    max-width: 680px;
  }

  .sust-ldr__stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .sust-ldr__num {
    display: block;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 700;
    color: #c9a84c;
    line-height: 1;
  }

  .sust-ldr__lbl {
    display: block;
    font-family: var(--font-body--family);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: rgba(245, 240, 232, 0.65);
    text-transform: uppercase;
    text-align: center;
    max-width: 120px;
  }

  .sust-ldr__divider {
    width: 1px;
    height: 56px;
    background: rgba(245, 240, 232, 0.22);
    flex-shrink: 0;
  }

  .sust-ldr__btn {
    display: inline-block;
    background: transparent;
    color: #f5f0e8;
    border: 1.5px solid rgba(245, 240, 232, 0.65);
    font-family: var(--font-body--family);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1rem 2.6rem;
    transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }

  .sust-ldr__btn:hover {
    background: #c9a84c;
    border-color: #c9a84c;
    color: #1a2744;
  }

  @media screen and (max-width: 749px) {
    .sust-ldr__stats {
      flex-direction: column;
      gap: 0;
      max-width: 100%;
    }

    .sust-ldr__stat {
      padding: 22px 0;
    }

    .sust-ldr__divider {
      width: 48px;
      height: 1px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sostenibilidad",
  "tag": "section",
  "class": "sust-ldr-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo"
    }
  ],
  "presets": [{ "name": "Sostenibilidad — Luz de Ribeira" }]
}
{% endschema %}
