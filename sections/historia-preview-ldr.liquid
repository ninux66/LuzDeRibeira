<section class="prenda-ldr">
  <div class="prenda-ldr__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1400
        | image_tag:
          class: 'prenda-ldr__img',
          widths: '600,800,1000,1400',
          sizes: '(min-width: 750px) 50vw, 100vw',
          loading: 'lazy',
          alt: 'Pieza artesanal — Luz de Ribeira'
      }}
    {%- else -%}
      <div class="prenda-ldr__placeholder"></div>
    {%- endif -%}
  </div>

  <div class="prenda-ldr__content">
    <span class="prenda-ldr__eyebrow">— Pieza destacada —</span>
    <h2 class="prenda-ldr__title">
      Llevarte un trozo<br>
      <em>de Galicia</em>
    </h2>
    <p class="prenda-ldr__desc">
      Cada collar y cada cuadro nace de conchas recogidas en las costas de Ribeira.
      Arte que se toca, que se siente y que perdura.
    </p>
    <a href="{{ routes.root_url }}collections/all" class="prenda-ldr__btn">
      Explorar la colección
    </a>
  </div>
</section>

{% stylesheet %}
  .prenda-ldr {
    display: flex;
    min-height: 70vh;
  }

  .prenda-ldr__media {
    flex: 0 0 52%;
    position: relative;
    overflow: hidden;
  }

  .prenda-ldr__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    position: absolute;
    inset: 0;
  }

  .prenda-ldr__placeholder {
    width: 100%;
    height: 100%;
    min-height: 480px;
    background: linear-gradient(135deg, #d9ceba 0%, #c8b99e 100%);
  }

  .prenda-ldr__content {
    flex: 0 0 48%;
    background: #1a2744;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 80px 72px;
    gap: 0;
  }

  .prenda-ldr__eyebrow {
    font-family: var(--font-body--family);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    color: #c9a84c;
    text-transform: uppercase;
    display: block;
    margin-bottom: 1.5rem;
  }

  .prenda-ldr__title {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 300;
    line-height: 1.1;
    color: #f5f0e8;
    margin: 0 0 1.75rem;
  }

  .prenda-ldr__title em {
    font-style: italic;
  }

  .prenda-ldr__desc {
    font-family: var(--font-body--family);
    font-size: 0.9rem;
    line-height: 1.8;
    color: rgba(245, 240, 232, 0.65);
    margin: 0 0 2.5rem;
    max-width: 360px;
  }

  .prenda-ldr__btn {
    display: inline-block;
    background: #c9a84c;
    color: #1a2744;
    font-family: var(--font-body--family);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1rem 2.4rem;
    transition: background 0.25s ease;
  }

  .prenda-ldr__btn:hover {
    background: #b89040;
  }

  @media screen and (max-width: 749px) {
    .prenda-ldr {
      flex-direction: column;
      min-height: auto;
    }

    .prenda-ldr__media {
      flex: none;
      height: 56vw;
      min-height: 260px;
      position: relative;
    }

    .prenda-ldr__placeholder {
      min-height: 260px;
    }

    .prenda-ldr__content {
      flex: none;
      padding: 48px 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pieza destacada — Luz de Ribeira",
  "tag": "section",
  "class": "prenda-ldr-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto de la pieza"
    }
  ],
  "presets": [{ "name": "Pieza destacada — Luz de Ribeira" }]
}
{% endschema %}
