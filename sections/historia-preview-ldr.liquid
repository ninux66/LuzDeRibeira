{%- assign dest_product = section.settings.product -%}

<section style="display:flex;min-height:70vh;font-family:inherit;">

  <div style="flex:0 0 52%;position:relative;overflow:hidden;background:linear-gradient(135deg,#d9ceba 0%,#c8b99e 100%);">
    {%- if dest_product != blank and dest_product.featured_image != blank -%}
      {{
        dest_product.featured_image
        | image_url: width: 1400
        | image_tag:
          widths: '600,800,1000,1400',
          sizes: '(min-width: 750px) 50vw, 100vw',
          loading: 'lazy',
          alt: dest_product.title,
          style: 'width:100%;height:100%;object-fit:cover;object-position:center;display:block;position:absolute;inset:0;'
      }}
    {%- elsif section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1400
        | image_tag:
          widths: '600,800,1000,1400',
          sizes: '(min-width: 750px) 50vw, 100vw',
          loading: 'lazy',
          alt: 'Pieza artesanal — Luz de Ribeira',
          style: 'width:100%;height:100%;object-fit:cover;object-position:center;display:block;position:absolute;inset:0;'
      }}
    {%- endif -%}
  </div>

  <div style="flex:0 0 48%;background:#f5f0e8;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:80px 72px;">
    <span style="display:block;font-family:var(--font-body--family);font-size:0.65rem;font-weight:700;letter-spacing:0.28em;color:#c9a84c;text-transform:uppercase;margin-bottom:1.5rem;">— Pieza destacada —</span>
    <h2 style="font-family:var(--font-heading--family);font-size:clamp(2rem,3.5vw,3.2rem);font-weight:300;line-height:1.1;color:#1a2744;margin:0 0 1.75rem;">
      {%- if dest_product != blank -%}
        {{ dest_product.title }}
      {%- else -%}
        Llevarte un trozo<br><em>de Galicia</em>
      {%- endif -%}
    </h2>
    <p style="font-family:var(--font-body--family);font-size:0.9rem;line-height:1.8;color:rgba(26,39,68,0.65);margin:0 0 2.5rem;max-width:360px;">
      {%- if dest_product != blank and dest_product.description != blank -%}
        {{ dest_product.description | strip_html | truncate: 160 }}
      {%- else -%}
        Cada collar y cada cuadro nace de conchas recogidas en las costas de Ribeira. Arte que se toca, que se siente y que perdura.
      {%- endif -%}
    </p>
    <a href="{%- if dest_product != blank -%}{{ dest_product.url }}{%- else -%}{{ routes.root_url }}collections/all{%- endif -%}" style="display:inline-block;background:#1a2744;color:#f5f0e8;font-family:var(--font-body--family);font-size:0.7rem;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;text-decoration:none;padding:1rem 2.4rem;">
      {%- if dest_product != blank -%}Ver la pieza{%- else -%}Explorar la colección{%- endif -%}
    </a>
  </div>

</section>

{% stylesheet %}
  @media screen and (max-width: 749px) {
    .prenda-ldr-wrapper > section { flex-direction: column !important; min-height: auto !important; }
    .prenda-ldr-wrapper > section > div:first-child { flex: none !important; height: 60vw; min-height: 240px; }
    .prenda-ldr-wrapper > section > div:last-child { flex: none !important; padding: 48px 24px !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pieza destacada",
  "tag": "section",
  "class": "prenda-ldr-wrapper",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Producto destacado"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen manual (si no hay producto)"
    }
  ],
  "presets": [{ "name": "Pieza destacada" }]
}
{% endschema %}
